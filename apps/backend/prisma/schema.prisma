/// @anchor product-proposal
model ProductProposal {
  /// @anchor product-proposal-id
  id                    String @id @default(uuid())
  /// @anchor product-proposal-material-requirement-id
  materialRequirementId String

  // Dane produktu znalezione przez AI / Google Search lub dodane ręcznie
  /// @anchor product-proposal-product-name
  productName  String // pełna nazwa handlowa
  /// @anchor product-proposal-manufacturer
  manufacturer String // producent
  /// @anchor product-proposal-model
  model        String? // symbol modelu
  /// @anchor product-proposal-source-url
  sourceUrl    String? // link do strony producenta lub dystrybutora

  // Dodatkowe pola ofertowe (ręcznie przez logistyka)
  /// @anchor product-proposal-price-netto
  priceNetto   Float? // cena netto za sztukę
  /// @anchor product-proposal-seller
  seller       String? // sprzedawca
  /// @anchor product-proposal-offer-number
  offerNumber  String? // numer oferty
  /// @anchor product-proposal-availability
  availability String? // dostępność (ile / kiedy)
  /// @anchor product-proposal-image-url
  imageUrl     String? // print screen / zdjęcie (ścieżka pliku)
  /// @anchor product-proposal-is-manual
  isManual     Boolean @default(false) // true = dodane ręcznie, false = AI

  // Pliki PDF dla propozycji
  /// @anchor product-proposal-data-sheet-url
  dataSheetUrl   String?
  /// @anchor product-proposal-data-sheet-name
  dataSheetName  String?
  /// @anchor product-proposal-compliance-url
  complianceUrl  String?
  /// @anchor product-proposal-compliance-name
  complianceName String?

  // Ocena dopasowania
  /// @anchor product-proposal-match-score
  matchScore Float? // 0.0–1.0: jak dobrze pasuje do wymagań technicznych

  // Wybór i odrzucenie przez użytkownika
  /// @anchor product-proposal-is-selected
  isSelected Boolean @default(false)
  /// @anchor product-proposal-is-rejected
  isRejected Boolean @default(false)

  // Role w splicie Wycena↔Zakup (niezależne od wersji/akceptacji).
  // Max jedna isOffer i jedna isPurchase na wymaganie (pilnowane w serwisie).
  /// @anchor product-proposal-is-offer
  isOffer Boolean @default(false) // produkt strony „Wycena"; cena wyceny = priceNetto
  /// @anchor product-proposal-is-purchase
  isPurchase Boolean @default(false) // produkt strony „Zakup"
  /// @anchor product-proposal-purchase-price-netto
  purchasePriceNetto Float? // cena zakupu gdy ta sama propozycja pełni obie role (Δ = purchasePriceNetto − priceNetto)

  // Dostawca produktu tej propozycji (rejestr Supplier — wybór po NIP lub wolny wpis po nazwie)
  /// @anchor product-proposal-supplier-id
  supplierId String?

  createdAt DateTime @default(now())

  /// @anchor product-proposal-material-requirement
  materialRequirement MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Cascade)
  /// @anchor product-proposal-supplier
  supplier             Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@map("product_proposals")
}

/// @anchor wbs-node
model WbsNode {
  /// @anchor wbs-node-id
  id        String   @id @default(uuid())
  /// @anchor wbs-node-parent-id
  parentId  String?
  /// @anchor wbs-node-node-id
  nodeId    String // ProcessNode — projekt/zlecenie
  /// @anchor wbs-node-version-id
  versionId String?
  /// @anchor wbs-node-name
  name      String
  /// @anchor wbs-node-type
  type      String   @default("") // work | material | equipment | service | ""
  /// @anchor wbs-node-status
  status    String   @default("")
  /// @anchor wbs-node-owner
  owner     String   @default("")
  /// @anchor wbs-node-resources
  resources String   @default("")
  /// @anchor wbs-node-cost
  cost      String   @default("")
  /// @anchor wbs-node-tags
  tags      String? // JSON array
  /// @anchor wbs-node-qa
  qa        String? // JSON array: [{ question, answer }]
  /// @anchor wbs-node-sort-order
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pola budżetowe (WORK / EXTERNAL_SERVICE)
  /// @anchor wbs-node-budget-type
  budgetType String? // WORK | MATERIAL | EXTERNAL_SERVICE
  /// @anchor wbs-node-unit
  unit       String  @default("szt")
  /// @anchor wbs-node-unit-cost
  unitCost   Float   @default(0)
  /// @anchor wbs-node-quantity
  quantity   Float   @default(1)
  /// @anchor wbs-node-total-cost
  totalCost  Float   @default(0)
  /// @anchor wbs-node-margin
  margin     Float   @default(0)
  /// @anchor wbs-node-discount
  discount   Float   @default(0)
  /// @anchor wbs-node-unit-price
  unitPrice  Float   @default(0)
  /// @anchor wbs-node-total-price
  totalPrice Float   @default(0)
  /// @anchor wbs-node-comment
  comment    String?
  /// @anchor wbs-node-strategy
  strategy   String? // strategia realizacji gałęzi (węzły top-level); Postgres text = bez limitu 256
  /// @anchor wbs-node-phase
  phase      String? // PRZED | INSTAL | PO
  /// @anchor wbs-node-gantt-start
  ganttStart DateTime? // data startowa paska na Gantcie (persystowana)
  /// @anchor wbs-node-gantt-end
  ganttEnd   DateTime? // data końcowa paska na Gantcie (persystowana)
  /// @anchor wbs-node-source-wbs-node-id
  /// Korzeń klonu — id liścia w wersji źródłowej (przy pierwszym klonie własne id).
  /// Klucz parowania baseline↔żywe dla WBS, odpowiednik `MaterialRequirement.sourceRequirementId`.
  sourceWbsNodeId   String?
  /// @anchor wbs-node-realization-closed
  /// Pozycja rozliczona mimo niedowykonania planu — różnica przestaje być „brakiem",
  /// liczy się jako oszczędność, a liść wypada z niedokończonych w pokryciu.
  realizationClosed Boolean @default(false)

  /// @anchor wbs-node-parent
  parent              WbsNode?          @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-children
  children            WbsNode[]         @relation("WbsTree")
  /// @anchor wbs-node-node
  node                ProcessNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-version
  version             ProjectVersion?   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-material-allocations
  materialAllocations WbsNodeMaterial[]
  /// @anchor wbs-node-material-card
  materialCard        MaterialRequirement? @relation("WbsNodeMaterialCard")

  @@index([nodeId, versionId])
  @@map("wbs_nodes")
}

/// @anchor leaf-actual
/// Wpis realizacji liścia WBS — jedno zdarzenie zakupu (dostawa, FV) albo wykonania
/// (dzień ekipy, odebrana usługa). Suma wpisów = strona ZAKUP w porównaniu F5; plan
/// zostaje po stronie WYCENA. Działa dla każdego typu liścia: work, material, equipment,
/// service — praca i usługi nie mają karty produktowej, więc `MaterialRequirement`
/// nie mógłby ich udźwignąć.
///
/// Kluczowane po `wbsRootId` (korzeń klonu liścia), NIE po id konkretnego wiersza WBS:
/// dzięki temu wpisy przeżywają utworzenie nowej wersji i NIE są klonowane w
/// `cloneVersionData` — zakup zdarzył się raz w świecie rzeczywistym i nie należy do
/// żadnej wersji. Świadomie bez FK na `wbsRootId` (liść bywa usuwany i odtwarzany
/// w kolejnej wersji); sprzątanie idzie kaskadą po `nodeId`.
model LeafActual {
  /// @anchor leaf-actual-id
  id         String   @id @default(uuid())
  /// @anchor leaf-actual-wbs-root-id
  wbsRootId  String // WbsNode.sourceWbsNodeId ?? WbsNode.id
  /// @anchor leaf-actual-node-id
  nodeId     String // ProcessNode — całe zamówienie jednym zapytaniem
  /// @anchor leaf-actual-entry-date
  entryDate  DateTime // data zdarzenia (domyślnie dziś), nie data wpisania
  /// @anchor leaf-actual-qty
  qty        Float
  /// @anchor leaf-actual-unit-cost
  unitCost   Float // koszt jedn. TEGO zdarzenia — druga dostawa bywa po innej cenie
  /// @anchor leaf-actual-comment
  comment    String?
  /// @anchor leaf-actual-doc-number
  docNumber  String? // nr FV / PZ / protokołu — sensowne dla materiału i sprzętu
  /// @anchor leaf-actual-manufacturer
  /// Producent i model TEGO zdarzenia — druga dostawa bywa zamiennikiem innej marki.
  /// Dlatego produkt siedzi na wpisie, a nie na pozycji: pozycja ma jeden produkt
  /// ofertowy (`ProductProposal isOffer`), a zakupów może być wiele i różnych.
  manufacturer String?
  /// @anchor leaf-actual-model
  model        String?
  /// @anchor leaf-actual-ean
  /// Kod EAN kupionego egzemplarza — identyfikuje towar jednoznacznie tam, gdzie producent
  /// i model bywają wpisane różnie („Janitza" vs „JANITZA electronics"). Tekst, nie liczba:
  /// EAN-13 ma wiodące zera i przekracza bezpieczny zakres liczb w JS.
  ean          String?
  /// @anchor leaf-actual-scope
  /// Zakres TEGO zdarzenia — odpowiednik producenta i modelu dla liści, które nie mają
  /// karty produktowej (praca, usługa, nocleg, paliwo). Jedno wolne pole zamiast pary
  /// producent + model: przy robociźnie nie ma czego rozbijać, liczy się „co zrobiono".
  /// Wypełniane wyłącznie dla typów innych niż materiał i sprzęt; wchodzi do wyszukiwarki.
  scope        String?
  /// @anchor leaf-actual-supplier-id
  supplierId String?
  /// @anchor leaf-actual-author-id
  authorId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// @anchor leaf-actual-node
  node     ProcessNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor leaf-actual-supplier
  supplier Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// @anchor leaf-actual-author
  author   User?       @relation("LeafActualAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([wbsRootId])
  @@map("leaf_actuals")
}

/// @anchor wbs-node-material
model WbsNodeMaterial {
  id         String @id @default(uuid())
  /// @anchor wbs-node-material-wbs-node-id
  wbsNodeId  String
  /// @anchor wbs-node-material-material-id
  /// UWAGA: trzyma `materials.id`, NIE id `MaterialRequirement` — mimo że wiersze opisują
  /// rozbicie pozycji na gałęzie. Po migracji `ce75dbe` dwa miejsca w `material-requirements`
  /// nadal podawały tu id wymagania: zapytania zwracały 0 wierszy, a zapisy leciały na klucz
  /// obcy pod pustym `.catch`. Zapytanie z poziomu wymagania idzie przez `req.materialId`.
  materialId String
  /// @anchor wbs-node-material-quantity
  quantity   Float  @default(1)

  wbsNode  WbsNode  @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([wbsNodeId, materialId])
  @@map("wbs_node_materials")
}

model UserMsToken {
  id             String   @id @default(uuid())
  userId         String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  msAccountEmail String?
  msDisplayName  String?
  /// @anchor user-ms-token-needs-reauth
  needsReauth    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ms_tokens")
}

/// Singleton — globalne ustawienia powiadomień: Web Push, sync MS To Do, alarmy (jeden wiersz, id = "singleton").
/// @anchor leave-calendar-settings
/// Ustawienia synchronizacji wspolnego kalendarza urlopowego Google. Jeden wiersz
/// ("singleton") — przelacznik ma byc wspolny dla calej instalacji, a nie per user.
model LeaveCalendarSettings {
  /// @anchor leave-calendar-settings-id
  id           String   @id @default("singleton")
  /// @anchor leave-calendar-sync-enabled
  /// false = cron nie rusza kalendarza. Domyslnie wylaczone, bo dopoki wnioski pisze
  /// takze AppSheet, automat mnozylby wpisy — wlaczamy dopiero po odcieciu AppSheet.
  syncEnabled  Boolean  @default(false)
  /// @anchor leave-calendar-last-run-at
  lastRunAt    DateTime?
  /// @anchor leave-calendar-last-run-summary
  /// Wynik ostatniego przebiegu w formie gotowej do pokazania w panelu administratora.
  lastRunSummary String?
  /// @anchor leave-calendar-updated-by-id
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("leave_calendar_settings")
}

model SystemNotificationSettings {
  /// @anchor notif-settings-id
  id                        String   @id @default("singleton")
  /// @anchor notif-settings-default-reminder-hour
  defaultReminderHour       Int      @default(9)
  /// @anchor notif-settings-snooze-presets
  snoozePresetsMinutes      Json     @default("[10,30,60]")
  /// @anchor notif-settings-trash-retention-days
  trashRetentionDays        Int      @default(30)
  /// @anchor notif-settings-ms-todo-sync-interval
  msTodoSyncIntervalMinutes Int      @default(5)
  /// @anchor notif-settings-ms-todo-enabled
  msTodoEnabled             Boolean  @default(true)
  /// @anchor notif-settings-web-push-enabled
  webPushEnabled            Boolean  @default(true)
  /// @anchor notif-settings-updated-at
  updatedAt                 DateTime @updatedAt

  @@map("system_notification_settings")
}

/// @anchor user-task
/// Zadanie osobiste usera — synchronizowane dwukierunkowo z MS To Do / Samsung Reminder.
model UserTask {
  /// @anchor user-task-id
  id             String         @id @default(uuid())
  /// @anchor user-task-user-id
  userId         String
  /// @anchor user-task-node-id
  nodeId         String?
  /// @anchor user-task-version-id
  versionId      String?
  /// @anchor user-task-title
  title          String
  /// @anchor user-task-description
  description    String?
  /// @anchor user-task-status
  status         String         @default("OPEN")
  /// @anchor user-task-planned-start
  plannedStart   DateTime?
  /// @anchor user-task-planned-end
  plannedEnd     DateTime?
  /// @anchor user-task-ms-todo-id
  msToDoId       String?        @unique
  /// @anchor user-task-ms-list-id
  msListId       String?
  /// @anchor user-task-ms-list-name
  msListName     String?
  /// @anchor user-task-ms-etag
  msEtag         String?
  /// @anchor user-task-ms-last-modified
  msLastModified DateTime?
  /// @anchor user-task-source
  source         String         @default("IGNITE")
  /// @anchor user-task-deleted-at
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// @anchor user-task-user
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @anchor user-task-node
  node      ProcessNode?  @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// @anchor user-task-reminders
  reminders TaskReminder[]

  @@index([userId, deletedAt])
  @@index([userId, nodeId])
  @@index([msToDoId])
  @@map("user_tasks")
}

/// @anchor task-reminder
/// Alarm do zadania osobistego — per user, obsługuje snooze i Web Push.
model TaskReminder {
  /// @anchor task-reminder-id
  id          String    @id @default(uuid())
  /// @anchor task-reminder-user-task-id
  userTaskId  String
  /// @anchor task-reminder-user-id
  userId      String
  /// @anchor task-reminder-remind-at
  remindAt    DateTime
  /// @anchor task-reminder-sent-at
  sentAt      DateTime?
  /// @anchor task-reminder-snoozed-from
  snoozedFrom DateTime?
  /// @anchor task-reminder-recur-interval-minutes
  recurIntervalMinutes Int? // null = alarm jednorazowy; ustawione = interwał serii cyklicznej (min)
  /// @anchor task-reminder-recur-end
  recurEnd    DateTime? // koniec okna serii cyklicznej; po tej dacie alarm nie odpala
  /// @anchor task-reminder-last-fired-at
  lastFiredAt DateTime? // ostatnie wyświetlone wystąpienie serii — kursor „już pokazane"
  createdAt   DateTime  @default(now())

  /// @anchor task-reminder-user-task
  userTask UserTask @relation(fields: [userTaskId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@index([userId])
  @@map("task_reminders")
}

/// @anchor ms-todo-sync-state
/// Stan synchronizacji MS To Do per user — deltaLink do inkrementalnego pobierania zmian.
model MsTodoSyncState {
  /// @anchor ms-todo-sync-state-user-id
  userId              String    @id
  /// @anchor ms-todo-sync-state-delta-link
  deltaLink           String?
  /// @anchor ms-todo-sync-state-started-at
  msTodoSyncStartedAt DateTime?
  /// @anchor ms-todo-sync-state-last-sync-at
  lastSyncAt          DateTime?
  /// @anchor ms-todo-sync-state-last-sync-error
  lastSyncError       String?

  /// @anchor ms-todo-sync-state-user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ms_todo_sync_state")
}

/// @anchor leave-type
/// Słownik rodzajów urlopu — jeden wiersz = jedna zakładka w widoku Urlopy.
model LeaveType {
  /// @anchor leave-type-id
  id        String   @id @default(uuid())
  /// @anchor leave-type-code
  code      String   @unique
  /// @anchor leave-type-name
  name      String   @unique
  /// @anchor leave-type-color
  color     String   @default("#3b82f6")
  /// @anchor leave-type-sort-order
  sortOrder Int      @default(0)
  /// @anchor leave-type-is-active
  isActive  Boolean  @default(true)
  /// @anchor leave-type-consumes-balance
  /// true = wniosek tego rodzaju pomniejsza pulę dni urlopowych (LeaveBalance) po zatwierdzeniu
  /// i nie może zostać złożony, gdy w puli brakuje dni.
  consumesBalance Boolean @default(false)
  /// @anchor leave-type-allows-hourly
  /// true = wniosek tego rodzaju dzieli sie na godziny (data + pelna godzina),
  /// false = urlop pelnodniowy, formularz pokazuje sam kalendarz bez godzin.
  /// Podstawa prawna per rodzaj opisana w back-stala HOURLY_LEAVE_CODES.
  allowsHourly Boolean @default(false)
  /// @anchor leave-type-calendar-label
  /// Tekst po mysliku w tytule wydarzenia kalendarza („AWL-urlop"). NULL = uzywamy
  /// mapy CALENDAR_LABELS po kodzie rodzaju, a gdy kodu tam nie ma — pola `name`.
  calendarLabel String?
  /// @anchor leave-type-max-days-per-year
  /// Ustawowy limit dni w roku kalendarzowym (Kodeks pracy): NA_ZADANIE = 4 (art. 167(2)),
  /// OPIEKA = 5 (art. 173(1)). NULL = brak limitu ustawowego (L4, bezpłatny) albo limit
  /// liczony osobno (WYPOCZYNKOWY z LeaveBalance, ZA_SWIETO_SOB z HolidayDayOff).
  maxDaysPerYear Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// @anchor leave-type-leaves
  leaves Leave[]
  /// @anchor leave-type-requests
  requests LeaveRequest[]

  @@map("leave_types")
}

/// @anchor leave
/// Pojedynczy wpis urlopowy pracownika w ramach jednego rodzaju urlopu.
model Leave {
  /// @anchor leave-id
  id          String   @id @default(uuid())
  /// @anchor leave-user-id
  userId      String
  /// @anchor leave-leave-type-id
  leaveTypeId String
  /// @anchor leave-date-from
  dateFrom    DateTime
  /// @anchor leave-date-to
  dateTo      DateTime
  /// @anchor leave-days-count
  daysCount   Float    @default(1)
  /// @anchor leave-note
  note        String?
  /// @anchor leave-leave-request-id
  /// Wpis powstaly z zatwierdzonego wniosku — cofniecie decyzji kasuje ten wpis.
  /// NULL dla wpisow zakladanych recznie przez administratora.
  leaveRequestId String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// @anchor leave-user
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @anchor leave-leave-type
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  /// @anchor leave-leave-request
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leaveTypeId])
  @@index([dateFrom])
  @@map("leaves")
}

/// @anchor holiday-day-off
/// Dzien wolny nalezny za swieto wypadajace w sobote (art. 130 §2 k.p.).
/// Propozycje na dany rok liczy backend z listy swiat o stalej dacie; wiersz powstaje
/// dopiero przy decyzji administratora, `approved` odblokowuje wnioski typu ZA_SWIETO_SOB.
model HolidayDayOff {
  /// @anchor holiday-day-off-id
  id           String    @id @default(uuid())
  /// @anchor holiday-day-off-year
  year         Int
  /// @anchor holiday-day-off-date
  /// Data swieta (sobota) — klucz naturalny wiersza.
  date         DateTime  @unique
  /// @anchor holiday-day-off-name
  name         String
  /// @anchor holiday-day-off-approved
  approved     Boolean   @default(false)
  /// @anchor holiday-day-off-approved-at
  approvedAt   DateTime?
  /// @anchor holiday-day-off-approved-by-id
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// @anchor holiday-day-off-approved-by
  approvedBy User? @relation("HolidayDayOffApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  /// @anchor holiday-day-off-requests
  /// Wnioski „Do wyboru za swieto w sobote" odbierane za ten konkretny dzien.
  requests   LeaveRequest[]

  @@index([year])
  @@map("holiday_days_off")
}

/// @anchor leave-request-status
/// Cykl życia wniosku: złożony → zatwierdzony albo odrzucony.
enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Urlop byl zatwierdzony, ale pracownik poprosil o wycofanie, a przelozony to potwierdzil.
  /// Dni wrocily do puli, wpis urlopowy i zdarzenie w kalendarzu zostaly skasowane.
  WITHDRAWN
}

/// @anchor leave-request
/// Wniosek urlopowy — formularz składany przez pracownika, z saldem dni pozostałych do wybrania.
model LeaveRequest {
  /// @anchor leave-request-id
  id                  String    @id @default(uuid())
  /// @anchor leave-request-user-id
  userId              String
  /// @anchor leave-request-leave-type-id
  leaveTypeId         String? // rodzaj_urlopu — opcjonalny, wniosek może powstać przed wyborem rodzaju
  /// @anchor leave-request-days-count
  daysCount           Float     @default(1) // dni_urlopu
  /// @anchor leave-request-holiday-day-off-id
  /// Za ktore swieto wypadajace w sobote odbierany jest dzien wolny —
  /// wymagane dla rodzaju ZA_SWIETO_SOB, dla pozostalych zawsze NULL.
  holidayDayOffId     String?
  /// @anchor leave-request-dependent-id
  dependentId         String? // podopieczny — wymagany gdy rodzaj urlopu = OPIEKA
  /// @anchor leave-request-date-start
  dateStart           DateTime
  /// @anchor leave-request-time-start
  timeStart           String? // "HH:mm"
  /// @anchor leave-request-date-end
  dateEnd             DateTime
  /// @anchor leave-request-time-end
  timeEnd             String? // "HH:mm"
  /// @anchor leave-request-office-from
  officeFrom          DateTime? // w biurze od
  /// @anchor leave-request-office-to
  officeTo            DateTime? // w biurze do
  /// @anchor leave-request-comment
  comment             String?
  /// @anchor leave-request-submitted-at
  submittedAt         DateTime? // data złożenia
  /// @anchor leave-request-approved-at
  approvedAt          DateTime? // data zatwierdzenia
  /// @anchor leave-request-status-field
  status              LeaveRequestStatus @default(PENDING) // PENDING | APPROVED | REJECTED
  /// @anchor leave-request-rejected-at
  rejectedAt          DateTime? // data odrzucenia
  /// @anchor leave-request-decision-comment
  decisionComment     String? // uzasadnienie decyzji przełożonego
  /// @anchor leave-request-decided-by-id
  decidedById         String? // kto podjął decyzję
  /// @anchor leave-request-remaining-y4
  /// remaining* to MIGAWKA salda z chwili złożenia wniosku (do wydruku formularza).
  /// Źródłem prawdy o dostępnych dniach jest model LeaveBalance.
  remainingY4         Float     @default(0) // zaległy sprzed 4 lat — dni jeszcze do wybrania
  /// @anchor leave-request-remaining-y3
  remainingY3         Float     @default(0) // zaległy sprzed 3 lat
  /// @anchor leave-request-remaining-y2
  remainingY2         Float     @default(0) // zaległy sprzed 2 lat
  /// @anchor leave-request-remaining-y1
  remainingY1         Float     @default(0) // zaległy sprzed roku
  /// @anchor leave-request-remaining-current
  remainingCurrentYear Float    @default(0) // z tego roku
  /// @anchor leave-request-withdrawal-requested-at
  /// Kiedy pracownik poprosil o wycofanie zatwierdzonego urlopu. Wniosek zostaje APPROVED
  /// (urlop nadal obowiazuje) az do potwierdzenia przez przelozonego — sama prosba niczego nie cofa.
  withdrawalRequestedAt   DateTime?
  /// @anchor leave-request-withdrawal-decided-at
  withdrawalDecidedAt     DateTime?
  /// @anchor leave-request-withdrawal-decided-by-id
  withdrawalDecidedById   String?
  /// @anchor leave-request-google-event-ids
  /// Id zdarzen we wspolnym kalendarzu Google zalozonych przy zatwierdzeniu wniosku.
  /// Lista, bo urlop przerwany weekendem albo swietem to kilka osobnych zdarzen —
  /// Google nie umie zrobic dziury w srodku zdarzenia calodniowego.
  /// Pusta = brak zdarzen (wniosek nierozpatrzony, integracja wylaczona albo API odmowilo).
  googleEventIds      String[]  @default([])
  /// @anchor leave-request-google-synced-at
  /// Kiedy ostatnio stan kalendarza zgodzil sie z wnioskiem. NULL przy niezerowym
  /// googleSyncError oznacza wpis, ktory nie trafil do kalendarza — do ponowienia.
  googleSyncedAt      DateTime?
  /// @anchor leave-request-google-sync-error
  /// Komunikat ostatniego nieudanego zapisu do kalendarza; NULL gdy poszlo dobrze.
  googleSyncError     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  /// @anchor leave-request-user
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @anchor leave-request-leave-type
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)
  /// @anchor leave-request-dependent
  dependent Dependent? @relation(fields: [dependentId], references: [id], onDelete: SetNull)
  /// @anchor leave-request-holiday-day-off
  holidayDayOff HolidayDayOff? @relation(fields: [holidayDayOffId], references: [id], onDelete: SetNull)
  /// @anchor leave-request-decided-by
  decidedBy User? @relation("LeaveRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  /// @anchor leave-request-withdrawal-decided-by
  withdrawalDecidedBy User? @relation("LeaveRequestWithdrawalDecider", fields: [withdrawalDecidedById], references: [id], onDelete: SetNull)
  /// @anchor leave-request-deductions
  deductions LeaveDeduction[]
  /// @anchor leave-request-leave
  /// Wpis urlopowy zalozony przy zatwierdzeniu wniosku (1:1).
  leave      Leave?

  @@index([userId])
  @@index([dateStart])
  @@index([submittedAt])
  @@index([leaveTypeId])
  @@index([dependentId])
  @@index([holidayDayOffId])
  @@index([status])
  @@map("leave_requests")
}

/// @anchor leave-balance
/// Pula dni urlopowych pracownika w danym roku — jedno źródło prawdy o dostępnych dniach.
/// Wiersze trzymamy per rok, więc kolumny „urlop z <rok>" w UI liczą się dynamicznie
/// względem roku bieżącego (okno: rok−4 … rok bieżący).
model LeaveBalance {
  /// @anchor leave-balance-id
  id              String   @id @default(uuid())
  /// @anchor leave-balance-user-id
  userId          String
  /// @anchor leave-balance-year
  year            Int
  /// @anchor leave-balance-entitlement-days
  entitlementDays Float    @default(0) // dni przysługujące za ten rok (ustawia ADMIN)
  /// @anchor leave-balance-used-days
  usedDays        Float    @default(0) // dni odjęte przez zatwierdzone wnioski
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// @anchor leave-balance-user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@map("leave_balances")
}

/// @anchor leave-deduction
/// Rozksięgowanie zatwierdzonego wniosku na roczne pule — pozwala cofnąć zatwierdzenie
/// i oddać dni dokładnie do tych lat, z których zostały pobrane.
model LeaveDeduction {
  /// @anchor leave-deduction-id
  id             String   @id @default(uuid())
  /// @anchor leave-deduction-request-id
  leaveRequestId String
  /// @anchor leave-deduction-year
  year           Int
  /// @anchor leave-deduction-days
  days           Float
  createdAt      DateTime @default(now())

  /// @anchor leave-deduction-request
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId])
  @@map("leave_deductions")
}

/// @anchor dependent
/// Podopieczny użytkownika — osoba, na którą pracownik może wziąć urlop opiekuńczy.
model Dependent {
  /// @anchor dependent-id
  id        String   @id @default(uuid())
  /// @anchor dependent-user-id
  userId    String
  /// @anchor dependent-first-name
  firstName String
  /// @anchor dependent-last-name
  lastName  String
  /// @anchor dependent-birth-date
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// @anchor dependent-user
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @anchor dependent-requests
  requests LeaveRequest[]

  @@index([userId])
  @@map("dependents")
}

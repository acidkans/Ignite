generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  firstName         String?
  lastName          String?
  phone             String?
  company           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  supervisorId      String?
  auditLogs         AuditLog[]
  nodePermissions   NodePermission[]   @relation("UserNodePermissions")
  ownedNodes        ProcessNode[]      @relation("OwnedProcessNodes")
  assignedSubtasks  Subtask[]          @relation("AssignedSubtasks")
  userEntityConfigs UserEntityConfig[]
  userRoles         UserRole[]
  supervisor        User?              @relation("UserSupervisor", fields: [supervisorId], references: [id])
  subordinates      User[]             @relation("UserSupervisor")
  teams             Team[]             @relation("TeamToUser")
  comments          Comment[]
  commentReads      CommentRead[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  msToken           UserMsToken?
  userTasks         UserTask[]
  msTodoSyncState   MsTodoSyncState?

  @@map("users")
}

model Comment {
  id               String   @id @default(uuid())
  orderId          String
  requirementId    String? // opcjonalne #oznaczenie wymagania
  userId           String
  text             String
  type             String   @default("NOTE") // NOTE | QUESTION | RESOLVED | URGENT
  mentionedUserIds String[] @default([])
  replyToId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  replyTo Comment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies Comment[] @relation("CommentReplies")
  reads   CommentRead[]

  @@map("comments")
}

model CommentRead {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  readAt    DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_reads")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  type          String // NEW_COMMENT | NEW_QUESTION
  title         String
  body          String
  orderId       String?
  requirementId String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Team {
  id              String           @id @default(uuid())
  name            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  nodePermissions NodePermission[] @relation("TeamNodePermissions")
  users           User[]           @relation("TeamToUser")

  @@map("teams")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model ProcessNode {
  id                        String                     @id @default(uuid())
  parentId                  String?
  name                      String
  type                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  isPublic                  Boolean                    @default(false)
  ownerId                   String?
  visibility                String                     @default("private")
  address                   String?
  contactPerson             String?
  customTypeLabel           String?
  nip                       String?
  region                    String?
  storagePath               String?
  mimeType                  String?
  fileSize                  Int?
  parsedPositions           String?
  documentCategory          String?
  oneDriveFolderId          String?
  oneDriveDriveId           String?
  oneDriveFolderName        String?
  oneDriveFinanseId         String?
  oneDriveDocumentacjaId    String?
  /// @anchor process-node-task-list-slug
  taskListSlug              String?  @unique
  /// @anchor process-node-order-stage
  orderStage                String   @default("WYCENA") // WYCENA | ZAAKCEPTOWANE | REALIZACJA | ROZLICZONE — znaczące dla type='order'
  /// @anchor process-node-accepted-version-id
  acceptedVersionId         String? // pointer na zaakceptowany ProjectVersion (baseline) — z konstrukcji jedna zaakceptowana wersja
  /// @anchor process-node-accepted-at
  acceptedAt                DateTime?
  /// @anchor process-node-accepted-by
  acceptedBy                String?
  budgetItems               BudgetLineItem[]
  hardware                  Hardware[]
  permissions               NodePermission[]           @relation("NodeACL")
  orderRequirements         OrderRequirements[]
  ancestors                 ProcessNodeClosure[]       @relation("NodeAncestors")
  descendants               ProcessNodeClosure[]       @relation("NodeDescendants")
  owner                     User?                      @relation("OwnedProcessNodes", fields: [ownerId], references: [id])
  parent                    ProcessNode?               @relation("NodeParent", fields: [parentId], references: [id])
  children                  ProcessNode[]              @relation("NodeParent")
  versions                  ProjectVersion[]
  site                      Site?
  subtasks                  Subtask[]
  schematicDocuments        SchematicDocument[]
  materialRequirements      MaterialRequirement[]
  materialDataSheets        Material[] @relation("MaterialDataSheet")
  materialCompliances       Material[] @relation("MaterialCompliance")
  wbsNodes                  WbsNode[]
  materialRequirementsLists MaterialRequirementsList[]
  documentHighlights        DocumentHighlight[]
  userTasks                 UserTask[]
  /// @anchor process-node-accepted-version
  acceptedVersion           ProjectVersion?            @relation("AcceptedVersion", fields: [acceptedVersionId], references: [id], onDelete: SetNull)
  /// @anchor process-node-quick-quotes
  quickQuotes               QuickQuote[]

  @@map("process_nodes")
}

model DocumentHighlight {
  id         String   @id @default(uuid())
  documentId String
  authorId   String?
  page       Int
  rects      Json
  color      String   @default("yellow")
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document   ProcessNode @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, page])
  @@map("document_highlights")
}

model ProjectVersion {
  id                   String                @id @default(uuid())
  nodeId               String
  label                String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(false)
  notes                String?
  budgetItems          BudgetLineItem[]
  requirements         OrderRequirements[]
  node                 ProcessNode           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  subtasks             Subtask[]
  materialRequirements MaterialRequirement[]
  wbsNodes             WbsNode[]
  /// @anchor project-version-accepted-for-nodes
  acceptedForNodes     ProcessNode[]         @relation("AcceptedVersion")

  @@unique([nodeId, label])
  @@map("project_versions")
}

model OrderRequirements {
  id                        String          @id @default(uuid())
  nodeId                    String
  versionId                 String?
  offerDeadline             DateTime?
  projectStart              DateTime?
  projectEnd                DateTime?
  projectGoal               String?
  projectItems              String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  wbsDescription            String?
  offerText                 String?
  wbsTree                   String?
  budgetNotes               String?
  clientContacts            String?
  clientProjectManager        String?
  clientProjectManagerCompany String?
  clientProjectManagerEmail   String?
  clientProjectManagerPhone   String?
  offerStatus               String?
  offerStatusComment        String?
  node                      ProcessNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version                   ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([nodeId, versionId])
  @@map("order_requirements")
}

model Subtask {
  id                   String                @id @default(uuid())
  nodeId               String
  versionId            String?
  name                 String
  description          String?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  assignedUserId       String?
  status               String                @default("NEW")
  visibilityType       String                @default("ALL")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  category             String?
  phase                String?
  requirementItemId    String?
  isAiGenerated        Boolean               @default(false)
  isApproved           Boolean               @default(true)
  budgetItems          BudgetLineItem[]
  files                SubtaskFile[]
  assignedUser         User?                 @relation("AssignedSubtasks", fields: [assignedUserId], references: [id])
  node                 ProcessNode           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  version              ProjectVersion?       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  schematicDocuments   SchematicDocument[]
  schematicMarkers     SchematicMarker[]
  materialRequirements MaterialRequirement[]
  markerLinks          SubtaskMarkerLink[]

  @@map("subtasks")
}

model BudgetLineItem {
  id          String          @id @default(uuid())
  versionId   String?
  subtaskId   String?
  wbsNodeId   String? // UUID węzła WBS (JSON tree, nie FK)
  type        String
  description String
  unit        String
  unitCost    Float
  quantity    Float
  totalCost   Float
  margin      Float
  discount    Float           @default(0)
  unitPrice   Float
  totalPrice  Float
  comment     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  nodeId      String
  node        ProcessNode     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  subtask     Subtask?        @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  version     ProjectVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("budget_line_items")
}

model SubtaskFile {
  id        String   @id @default(uuid())
  subtaskId String
  name      String
  path      String
  size      Int
  mimeType  String
  createdAt DateTime @default(now())
  subtask   Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("subtask_files")
}

model SubtaskTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subtask_templates")
}

model Hardware {
  id             String      @id @default(uuid())
  serialNumber   String
  name           String
  model          String
  manufacturer   String
  productionYear Int
  siteId         String
  site           ProcessNode @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("hardware")
}

model Offer {
  id         String   @id @default(uuid())
  nodeId     String
  fileName   String
  positions  String // JSON array of parsed positions
  documentId String? // optional reference to source document (may be deleted)
  createdAt  DateTime @default(now())
  createdBy  String?

  /// @anchor offer-supplier-id
  supplierId  String? // FK do Supplier — wystawca oferty (nie adresat)
  /// @anchor offer-offer-number
  offerNumber String? // numer oferty z parsera, potwierdzany w modalu
  /// @anchor offer-offer-date
  offerDate   DateTime? // data wystawienia oferty
  /// @anchor offer-valid-until
  validUntil  DateTime? // termin ważności oferty

  /// @anchor offer-supplier
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
}

model ProcessNodeClosure {
  ancestorId   String
  descendantId String
  depth        Int
  ancestor     ProcessNode @relation("NodeAncestors", fields: [ancestorId], references: [id])
  descendant   ProcessNode @relation("NodeDescendants", fields: [descendantId], references: [id])

  @@id([ancestorId, descendantId])
  @@map("process_node_closure")
}

model NodePermission {
  id         String      @id @default(uuid())
  nodeId     String
  userId     String?
  roleType   String?
  permission String
  teamId     String?
  node       ProcessNode @relation("NodeACL", fields: [nodeId], references: [id], onDelete: Cascade)
  team       Team?       @relation("TeamNodePermissions", fields: [teamId], references: [id], onDelete: Cascade)
  user       User?       @relation("UserNodePermissions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nodeId, userId])
  @@unique([nodeId, roleType])
  @@unique([nodeId, teamId])
  @@map("node_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

model FileMetadata {
  id        String   @id @default(uuid())
  name      String
  size      Int
  mimeType  String
  path      String
  createdAt DateTime @default(now())

  @@map("files")
}

model Site {
  id               String      @id
  number           String?
  structureType    String?
  accessDesc       String?
  additionalDesc   String?
  drivingDesc      String?
  shelterType      String?
  greenfield       Boolean     @default(false)
  addressStreet    String?
  addressCity      String?
  addressZipCode   String?
  addressCountry   String?
  addressLatitude  Float?
  addressLongitude Float?
  customData       Json        @default("{}")
  contactEmail     String?
  contactFirstName String?
  contactLastName  String?
  contactPhone     String?
  processNode      ProcessNode @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("sites")
}

/// Singleton — dane „mojej firmy" do wyliczeń (jeden wiersz, id = "singleton").
/// Pola 1:1 z `Site` (oprócz relacji do ProcessNode i pól specyficznych dla lokalizacji
/// terenowej — Company nie ma `structureType/accessDesc/drivingDesc/shelterType/greenfield`,
/// bo to atrybuty obiektu w terenie, nie firmy macierzystej).
model Company {
  /// @anchor company-id
  id               String  @id @default("singleton")
  /// @anchor company-name
  name             String?
  /// @anchor company-number
  number           String?
  /// @anchor company-additional-desc
  additionalDesc   String?
  /// @anchor company-address-street
  addressStreet    String?
  /// @anchor company-address-city
  addressCity      String?
  /// @anchor company-address-zip-code
  addressZipCode   String?
  /// @anchor company-address-country
  addressCountry   String?
  /// @anchor company-address-latitude
  addressLatitude  Float?
  /// @anchor company-address-longitude
  addressLongitude Float?
  /// @anchor company-custom-data
  customData       Json    @default("{}")
  /// @anchor company-contact-email
  contactEmail     String?
  /// @anchor company-contact-first-name
  contactFirstName String?
  /// @anchor company-contact-last-name
  contactLastName  String?
  /// @anchor company-contact-phone
  contactPhone     String?

  @@map("companies")
}

/// Singleton — konfiguracja serwera poczty wychodzącej (SMTP), jeden wiersz id = "singleton".
/// Źródło prawdy dla wysyłki maili (panel „Poczta SMTP"). Gdy puste — fallback do zmiennych env SMTP_*.
model SmtpSettings {
  /// @anchor smtp-settings-id
  id        String   @id @default("singleton")
  /// @anchor smtp-settings-host
  host      String?
  /// @anchor smtp-settings-port
  port      Int?     @default(587)
  /// @anchor smtp-settings-secure
  secure    Boolean  @default(false)
  /// @anchor smtp-settings-username
  username  String?
  /// @anchor smtp-settings-password
  password  String?
  /// @anchor smtp-settings-from-email
  fromEmail String?
  /// @anchor smtp-settings-from-name
  fromName  String?
  /// @anchor smtp-settings-reply-to
  replyTo   String?
  /// @anchor smtp-settings-updated-at
  updatedAt DateTime @default(now()) @updatedAt

  @@map("smtp_settings")
}

model UserEntityConfig {
  id         String @id @default(uuid())
  userId     String
  entityType String
  config     Json
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType])
  @@map("user_entity_configs")
}

model SchematicDocument {
  id        String            @id @default(uuid())
  nodeId    String
  subtaskId String?
  fileUrl   String
  fileName  String
  createdAt DateTime          @default(now())
  markers   SchematicMarker[]
  node      ProcessNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  subtask   Subtask?          @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("schematic_documents")
}

model SchematicMarker {
  id          String             @id @default(uuid())
  schematicId String
  subtaskId   String?
  type        String             @default("POINT") // "POINT" lub "LINE"
  x           Float
  y           Float
  x2          Float? // Dla linii: koniec X
  y2          Float? // Dla linii: koniec Y
  pageNumber  Int
  note        String?
  name        String?
  question    String?
  createdAt   DateTime           @default(now())
  schematic   SchematicDocument  @relation(fields: [schematicId], references: [id], onDelete: Cascade)
  subtask     Subtask?           @relation(fields: [subtaskId], references: [id], onDelete: SetNull)
  attachments   MarkerAttachment[]
  wbsLinks      WbsMarkerLink[]
  subtaskLinks  SubtaskMarkerLink[]

  @@map("schematic_markers")
}

model SubtaskMarkerLink {
  id        String          @id @default(uuid())
  subtaskId String
  markerId  String
  createdAt DateTime        @default(now())
  subtask   Subtask         @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  marker    SchematicMarker @relation(fields: [markerId], references: [id], onDelete: Cascade)

  @@unique([subtaskId, markerId])
  @@index([subtaskId])
  @@map("subtask_marker_links")
}

model WbsMarkerLink {
  id        String          @id @default(uuid())
  wbsNodeId String
  markerId  String
  createdAt DateTime        @default(now())
  marker    SchematicMarker @relation(fields: [markerId], references: [id], onDelete: Cascade)

  @@unique([wbsNodeId, markerId])
  @@index([wbsNodeId])
  @@map("wbs_marker_links")
}

model MarkerAttachment {
  id        String          @id @default(uuid())
  markerId  String
  fileUrl   String
  fileType  String // "IMAGE", "AUDIO", "FILE"
  fileName  String
  note      String?
  createdAt DateTime        @default(now())
  marker    SchematicMarker @relation(fields: [markerId], references: [id], onDelete: Cascade)

  @@map("marker_attachments")
}

// ─── Lista Wymagań Materiałowych ────────────────────────────────────────────

/// @anchor material-requirements-list
model MaterialRequirementsList {
  /// @anchor mat-list-id
  id        String    @id @default(uuid())
  /// @anchor mat-list-node-id
  nodeId    String
  /// @anchor mat-list-name
  name      String
  /// @anchor mat-list-version
  version   Int       @default(1)
  /// @anchor mat-list-is-locked
  isLocked  Boolean   @default(false)
  /// @anchor mat-list-locked-by
  lockedBy  String?
  /// @anchor mat-list-locked-at
  lockedAt  DateTime?
  /// @anchor mat-list-created-by
  createdBy String?
  /// @anchor mat-list-parent-id
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// @anchor mat-list-node
  node         ProcessNode                @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor mat-list-parent
  parent       MaterialRequirementsList?  @relation("ListVersions", fields: [parentId], references: [id])
  /// @anchor mat-list-children
  children     MaterialRequirementsList[] @relation("ListVersions")
  /// @anchor mat-list-requirements
  requirements MaterialRequirement[]

  @@map("material_requirements_lists")
}

/// @anchor material
model Material {
  /// @anchor material-id
  id             String   @id @default(uuid())
  /// @anchor material-manufacturer
  manufacturer   String
  /// @anchor material-model
  model          String?
  /// @anchor material-product-name
  productName    String?
  /// @anchor material-type
  type           String   // DEVICE | MATERIAL | CABLE | SOFTWARE | SERVICE
  /// @anchor material-data-sheet-url
  dataSheetUrl   String?  // legacy: relatywna nazwa pliku (fallback gdy brak FK)
  /// @anchor material-data-sheet-name
  dataSheetName  String?
  /// @anchor material-compliance-url
  complianceUrl  String?
  /// @anchor material-compliance-name
  complianceName String?
  /// @anchor material-image-url
  imageUrl       String?
  /// @anchor material-price-netto
  priceNetto     Float?
  /// @anchor material-product-url
  productUrl     String?
  /// @anchor material-seller
  seller         String?
  /// @anchor material-data-sheet-document-id
  dataSheetDocumentId String?
  /// @anchor material-compliance-document-id
  complianceDocumentId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// @anchor material-data-sheet-document
  dataSheetDocument    ProcessNode? @relation("MaterialDataSheet", fields: [dataSheetDocumentId], references: [id], onDelete: SetNull)
  /// @anchor material-compliance-document
  complianceDocument   ProcessNode? @relation("MaterialCompliance", fields: [complianceDocumentId], references: [id], onDelete: SetNull)
  /// @anchor material-requirements
  requirements         MaterialRequirement[]
  /// @anchor material-wbs-allocations
  wbsAllocations       WbsNodeMaterial[]
  /// @anchor material-stock
  stock                MaterialStock[]

  @@unique([manufacturer, model])
  @@map("materials")
}

/// @anchor material-stock
model MaterialStock {
  /// @anchor material-stock-id
  id         String   @id @default(uuid())
  /// @anchor material-stock-material-id
  materialId String
  /// @anchor material-stock-quantity
  quantity   Decimal
  /// @anchor material-stock-location
  location   String?
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  /// @anchor material-stock-material
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_stock")
}

/// @anchor material-requirement
model MaterialRequirement {
  /// @anchor mat-req-id
  id        String  @id @default(uuid())
  /// @anchor mat-req-node-id
  nodeId    String
  /// @anchor mat-req-version-id
  versionId String?
  /// @anchor mat-req-list-id
  listId    String?

  // Nazwa wymagania (niezależna od nazwy produktu)
  /// @anchor mat-req-name
  name String? // nazwa wymagania (np. "Kamera główna", "Zasilacz awaryjny")

  // Referencja do zaakceptowanego produktu z tabeli materials
  /// @anchor mat-req-material-id
  materialId   String? // FK do Material (baza katalogowa)
  /// @anchor mat-req-material
  material     Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  /// @anchor mat-req-type
  type           String // DEVICE | MATERIAL | CABLE | SOFTWARE | SERVICE
  /// @anchor mat-req-quantity
  quantity       Float
  /// @anchor mat-req-unit
  unit           String // szt, m, kg, kpl
  /// @anchor mat-req-technical-spec
  technicalSpec  String? // pełne wymagania techniczne z dokumentu
  /// @anchor mat-req-source-document
  sourceDocument String? // nazwa pliku PDF źródłowego

  // Przypisanie do WBS
  /// @anchor mat-req-assigned-subtask-id
  assignedSubtaskId  String?
  /// @anchor mat-req-wbs-node-id
  wbsNodeId          String? @unique // FK do wbs_nodes — karta produktowa przypisana do węzła WBS (1:1)
  /// @anchor mat-req-wbs-node-ids
  wbsNodeIds         String? // @deprecated JSON array UUID węzłów WBS (wielowybór) — zastąpione przez WbsNodeMaterial
  /// @anchor mat-req-wbs-node-allocations
  wbsNodeAllocations String? // @deprecated JSON: {nodeId: quantity} — zastąpione przez WbsNodeMaterial.quantity
  /// @anchor mat-req-is-ai-assigned
  isAiAssigned       Boolean @default(false) // true = przypisane przez AI, false = ręcznie
  /// @anchor mat-req-ai-confidence
  aiConfidence       Float? // pewność AI 0.0–1.0

  // Tabela zgodności (JSON): { requirements: string[], products: {id,name}[], matrix: {key: "spełnia"|"nie spełnia"|"częściowo"} }
  /// @anchor mat-req-compliance-data
  complianceData String?

  // Dostępność / czas dostawy (transient — nie w katalogu materials)
  /// @anchor mat-req-availability
  availability String? // dostępność wpisana w ProductCard (czas dostawy / stan)

  // Budżet wymagania (niezależny od ceny referencyjnej w materials)
  /// @anchor mat-req-budgeted-price-netto
  budgetedPriceNetto Float? // zabudżetowana cena netto za sztukę (do kalkulacji kosztów WBS)

  // Przypisanie pozycji oferty (nadpisuje budgetedPriceNetto przy wyświetlaniu)
  /// @anchor mat-req-offer-id
  offerId               String? // FK do Offer (nullable)
  /// @anchor mat-req-offer-position-idx
  offerPositionIdx      Int?    // indeks w Offer.positions[]
  /// @anchor mat-req-offer-position-snapshot
  offerPositionSnapshot String? // JSON snapshot: {lp, name, priceNetto, unit, wbsPath}

  // Status weryfikacji
  /// @anchor mat-req-status
  status String @default("PENDING") // PENDING | CONFIRMED | REJECTED | PROPOSAL

  // Parowanie baseline↔żywe (wersjonowanie)
  /// @anchor mat-req-source-requirement-id
  sourceRequirementId String? // id oryginału (żywego wiersza) w klonie wersji — klucz parowania baseline↔żywe

  // Proweniencja budgetedPriceNetto
  /// @anchor mat-req-budget-source
  budgetSource String? // QUICKQUOTE | MANUAL — skąd pochodzi budgetedPriceNetto

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// @anchor mat-req-node
  node            ProcessNode               @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor mat-req-version
  version         ProjectVersion?           @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// @anchor mat-req-list
  list            MaterialRequirementsList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// @anchor mat-req-assigned-subtask
  assignedSubtask Subtask?                  @relation(fields: [assignedSubtaskId], references: [id], onDelete: SetNull)
  /// @anchor mat-req-wbs-node
  wbsNode         WbsNode?                  @relation("WbsNodeMaterialCard", fields: [wbsNodeId], references: [id], onDelete: Cascade)
  /// @anchor mat-req-proposals
  proposals       ProductProposal[]
  /// @anchor mat-req-quick-quote-items
  quickQuoteItems QuickQuoteItem[]

  @@map("material_requirements")
}

/// @anchor supplier
model Supplier {
  /// @anchor supplier-id
  id            String    @id @default(uuid())
  /// @anchor supplier-name
  name          String
  /// @anchor supplier-nip
  nip           String?   @unique // null = dostawca zagraniczny / wolny wpis
  /// @anchor supplier-address
  address       String?
  /// @anchor supplier-contact-person
  contactPerson String?
  /// @anchor supplier-contact-email
  contactEmail  String?
  /// @anchor supplier-contact-phone
  contactPhone  String?
  /// @anchor supplier-api-adapter
  apiAdapter    String? // identyfikator adaptera API (SupplierGateway) — null = dostawca tylko PDF-owy
  /// @anchor supplier-is-active
  isActive      Boolean   @default(true)
  /// @anchor supplier-vat-status
  vatStatus     String? // status z Białej listy podatników VAT (np. "Czynny")
  /// @anchor supplier-verified-at
  verifiedAt    DateTime? // stempel ostatniej weryfikacji NIP w Białej liście
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// @anchor supplier-offers
  offers          Offer[]
  /// @anchor supplier-quick-quote-items
  quickQuoteItems QuickQuoteItem[]

  @@map("suppliers")
}

/// @anchor quick-quote
model QuickQuote {
  /// @anchor quick-quote-id
  id          String    @id @default(uuid())
  /// @anchor quick-quote-node-id
  nodeId      String
  /// @anchor quick-quote-name
  name        String
  /// @anchor quick-quote-status
  status      String    @default("DRAFT") // DRAFT | VERIFIED | LOCKED | BASELINE | ARCHIVED | EXPIRED
  /// @anchor quick-quote-parent-id
  parentId    String? // wersjonowanie jak MaterialRequirementsList.parentId
  /// @anchor quick-quote-valid-until
  validUntil  DateTime?
  /// @anchor quick-quote-locked-at
  lockedAt    DateTime?
  /// @anchor quick-quote-locked-by
  lockedBy    String?
  /// @anchor quick-quote-created-by
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// @anchor quick-quote-node
  node     ProcessNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor quick-quote-parent
  parent   QuickQuote?  @relation("QuickQuoteVersions", fields: [parentId], references: [id])
  /// @anchor quick-quote-children
  children QuickQuote[] @relation("QuickQuoteVersions")
  /// @anchor quick-quote-items
  items    QuickQuoteItem[]

  @@map("quick_quotes")
}

/// @anchor quick-quote-item
model QuickQuoteItem {
  /// @anchor qq-item-id
  id                    String    @id @default(uuid())
  /// @anchor qq-item-quick-quote-id
  quickQuoteId          String
  /// @anchor qq-item-material-requirement-id
  materialRequirementId String? // SetNull — baseline przeżywa usunięcie wymagania

  // Zdenormalizowany snapshot wymagania w momencie capture
  /// @anchor qq-item-req-name
  reqName      String? // nazwa wymagania w momencie capture
  /// @anchor qq-item-qty-at-capture
  qtyAtCapture Float? // zapotrzebowanie w momencie capture
  /// @anchor qq-item-unit
  unit         String? // szt, m, kg, kpl

  // Źródło wyceny
  /// @anchor qq-item-source
  source      String // API | STOCK | MANUAL
  /// @anchor qq-item-supplier-id
  supplierId  String?
  /// @anchor qq-item-external-ref
  externalRef String? // identyfikator produktu u dostawcy (API)
  /// @anchor qq-item-source-url
  sourceUrl   String?
  /// @anchor qq-item-captured-at
  capturedAt  DateTime  @default(now())
  /// @anchor qq-item-queried-by
  queriedBy   String?

  // Waluty — kurs NBP zamrożony w momencie capture (wzorzec fetchNbpRate z kanału PDF)
  /// @anchor qq-item-price-original-netto
  priceOriginalNetto Float? // cena netto w walucie oryginalnej
  /// @anchor qq-item-currency
  currency           String? // PLN | EUR | USD ...
  /// @anchor qq-item-exchange-rate
  exchangeRate       Float? // kurs NBP z rateDate
  /// @anchor qq-item-rate-date
  rateDate           DateTime?
  /// @anchor qq-item-price-netto-pln
  priceNettoPln      Float? // cena efektywna PLN (może zawierać korektę logistyka)
  /// @anchor qq-item-price-netto-api
  priceNettoApi      Float? // surowa cena z API/źródła — niemutowalna, osobno od efektywnej

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// @anchor qq-item-quick-quote
  quickQuote          QuickQuote           @relation(fields: [quickQuoteId], references: [id], onDelete: Cascade)
  /// @anchor qq-item-material-requirement
  materialRequirement MaterialRequirement? @relation(fields: [materialRequirementId], references: [id], onDelete: SetNull)
  /// @anchor qq-item-supplier
  supplier            Supplier?            @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@map("quick_quote_items")
}

model DefaultProjectItem {
  id           String   @id @default(uuid())
  category     String // terminowe | instalacyjne | organizacyjne | ...
  name         String
  description  String?
  assignedRole String? // ADMIN | MANAGER | LOGISTYK | USER | null
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("default_project_items")
}

/// @anchor wbs-leaf-defaults-model
/// Konfigurowalne wartości domyślne liści budżetowych — osobne dla KAŻDEGO zamówienia
/// (ProcessNode). Nowe zamówienie nie ma wpisu → frontend stosuje bazę wyzerowaną.
model WbsLeafDefaults {
  id String @id @default(uuid())

  /// @anchor wbs-leaf-defaults-node-id
  nodeId String @unique // ProcessNode.id (zamówienie)

  /// @anchor wbs-leaf-defaults-data
  data String // JSON: { work:{unit,unitCost,margin,quantity}, service:{...}, ... }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wbs_leaf_defaults")
}

/// @anchor product-proposal
model ProductProposal {
  /// @anchor product-proposal-id
  id                    String @id @default(uuid())
  /// @anchor product-proposal-material-requirement-id
  materialRequirementId String

  // Dane produktu znalezione przez AI / Google Search lub dodane ręcznie
  /// @anchor product-proposal-product-name
  productName  String // pełna nazwa handlowa
  /// @anchor product-proposal-manufacturer
  manufacturer String // producent
  /// @anchor product-proposal-model
  model        String? // symbol modelu
  /// @anchor product-proposal-source-url
  sourceUrl    String? // link do strony producenta lub dystrybutora

  // Dodatkowe pola ofertowe (ręcznie przez logistyka)
  /// @anchor product-proposal-price-netto
  priceNetto   Float? // cena netto za sztukę
  /// @anchor product-proposal-seller
  seller       String? // sprzedawca
  /// @anchor product-proposal-offer-number
  offerNumber  String? // numer oferty
  /// @anchor product-proposal-availability
  availability String? // dostępność (ile / kiedy)
  /// @anchor product-proposal-image-url
  imageUrl     String? // print screen / zdjęcie (ścieżka pliku)
  /// @anchor product-proposal-is-manual
  isManual     Boolean @default(false) // true = dodane ręcznie, false = AI

  // Pliki PDF dla propozycji
  /// @anchor product-proposal-data-sheet-url
  dataSheetUrl   String?
  /// @anchor product-proposal-data-sheet-name
  dataSheetName  String?
  /// @anchor product-proposal-compliance-url
  complianceUrl  String?
  /// @anchor product-proposal-compliance-name
  complianceName String?

  // Ocena dopasowania
  /// @anchor product-proposal-match-score
  matchScore Float? // 0.0–1.0: jak dobrze pasuje do wymagań technicznych

  // Wybór i odrzucenie przez użytkownika
  /// @anchor product-proposal-is-selected
  isSelected Boolean @default(false)
  /// @anchor product-proposal-is-rejected
  isRejected Boolean @default(false)

  // Role w splicie Wycena↔Zakup (niezależne od wersji/akceptacji).
  // Max jedna isOffer i jedna isPurchase na wymaganie (pilnowane w serwisie).
  /// @anchor product-proposal-is-offer
  isOffer Boolean @default(false) // produkt strony „Wycena"; cena wyceny = priceNetto
  /// @anchor product-proposal-is-purchase
  isPurchase Boolean @default(false) // produkt strony „Zakup"
  /// @anchor product-proposal-purchase-price-netto
  purchasePriceNetto Float? // cena zakupu gdy ta sama propozycja pełni obie role (Δ = purchasePriceNetto − priceNetto)

  createdAt DateTime @default(now())

  /// @anchor product-proposal-material-requirement
  materialRequirement MaterialRequirement @relation(fields: [materialRequirementId], references: [id], onDelete: Cascade)

  @@map("product_proposals")
}

/// @anchor wbs-node
model WbsNode {
  /// @anchor wbs-node-id
  id        String   @id @default(uuid())
  /// @anchor wbs-node-parent-id
  parentId  String?
  /// @anchor wbs-node-node-id
  nodeId    String // ProcessNode — projekt/zlecenie
  /// @anchor wbs-node-version-id
  versionId String?
  /// @anchor wbs-node-name
  name      String
  /// @anchor wbs-node-type
  type      String   @default("") // work | material | equipment | service | ""
  /// @anchor wbs-node-status
  status    String   @default("")
  /// @anchor wbs-node-owner
  owner     String   @default("")
  /// @anchor wbs-node-resources
  resources String   @default("")
  /// @anchor wbs-node-cost
  cost      String   @default("")
  /// @anchor wbs-node-tags
  tags      String? // JSON array
  /// @anchor wbs-node-qa
  qa        String? // JSON array: [{ question, answer }]
  /// @anchor wbs-node-sort-order
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Pola budżetowe (WORK / EXTERNAL_SERVICE)
  /// @anchor wbs-node-budget-type
  budgetType String? // WORK | MATERIAL | EXTERNAL_SERVICE
  /// @anchor wbs-node-unit
  unit       String  @default("szt")
  /// @anchor wbs-node-unit-cost
  unitCost   Float   @default(0)
  /// @anchor wbs-node-quantity
  quantity   Float   @default(1)
  /// @anchor wbs-node-total-cost
  totalCost  Float   @default(0)
  /// @anchor wbs-node-margin
  margin     Float   @default(0)
  /// @anchor wbs-node-discount
  discount   Float   @default(0)
  /// @anchor wbs-node-unit-price
  unitPrice  Float   @default(0)
  /// @anchor wbs-node-total-price
  totalPrice Float   @default(0)
  /// @anchor wbs-node-comment
  comment    String?
  /// @anchor wbs-node-strategy
  strategy   String? // strategia realizacji gałęzi (węzły top-level); Postgres text = bez limitu 256
  /// @anchor wbs-node-phase
  phase      String? // PRZED | INSTAL | PO
  /// @anchor wbs-node-gantt-start
  ganttStart DateTime? // data startowa paska na Gantcie (persystowana)
  /// @anchor wbs-node-gantt-end
  ganttEnd   DateTime? // data końcowa paska na Gantcie (persystowana)

  /// @anchor wbs-node-parent
  parent              WbsNode?          @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-children
  children            WbsNode[]         @relation("WbsTree")
  /// @anchor wbs-node-node
  node                ProcessNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-version
  version             ProjectVersion?   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// @anchor wbs-node-material-allocations
  materialAllocations WbsNodeMaterial[]
  /// @anchor wbs-node-material-card
  materialCard        MaterialRequirement? @relation("WbsNodeMaterialCard")

  @@index([nodeId, versionId])
  @@map("wbs_nodes")
}

/// @anchor wbs-node-material
model WbsNodeMaterial {
  id         String @id @default(uuid())
  /// @anchor wbs-node-material-wbs-node-id
  wbsNodeId  String
  /// @anchor wbs-node-material-material-id
  materialId String
  /// @anchor wbs-node-material-quantity
  quantity   Float  @default(1)

  wbsNode  WbsNode  @relation(fields: [wbsNodeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([wbsNodeId, materialId])
  @@map("wbs_node_materials")
}

model UserMsToken {
  id             String   @id @default(uuid())
  userId         String   @unique
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  msAccountEmail String?
  msDisplayName  String?
  /// @anchor user-ms-token-needs-reauth
  needsReauth    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_ms_tokens")
}

/// Singleton — globalne ustawienia powiadomień: Web Push, sync MS To Do, alarmy (jeden wiersz, id = "singleton").
model SystemNotificationSettings {
  /// @anchor notif-settings-id
  id                        String   @id @default("singleton")
  /// @anchor notif-settings-default-reminder-hour
  defaultReminderHour       Int      @default(9)
  /// @anchor notif-settings-snooze-presets
  snoozePresetsMinutes      Json     @default("[10,30,60]")
  /// @anchor notif-settings-trash-retention-days
  trashRetentionDays        Int      @default(30)
  /// @anchor notif-settings-ms-todo-sync-interval
  msTodoSyncIntervalMinutes Int      @default(5)
  /// @anchor notif-settings-ms-todo-enabled
  msTodoEnabled             Boolean  @default(true)
  /// @anchor notif-settings-web-push-enabled
  webPushEnabled            Boolean  @default(true)
  /// @anchor notif-settings-updated-at
  updatedAt                 DateTime @updatedAt

  @@map("system_notification_settings")
}

/// @anchor user-task
/// Zadanie osobiste usera — synchronizowane dwukierunkowo z MS To Do / Samsung Reminder.
model UserTask {
  /// @anchor user-task-id
  id             String         @id @default(uuid())
  /// @anchor user-task-user-id
  userId         String
  /// @anchor user-task-node-id
  nodeId         String?
  /// @anchor user-task-version-id
  versionId      String?
  /// @anchor user-task-title
  title          String
  /// @anchor user-task-description
  description    String?
  /// @anchor user-task-status
  status         String         @default("OPEN")
  /// @anchor user-task-planned-start
  plannedStart   DateTime?
  /// @anchor user-task-planned-end
  plannedEnd     DateTime?
  /// @anchor user-task-ms-todo-id
  msToDoId       String?        @unique
  /// @anchor user-task-ms-list-id
  msListId       String?
  /// @anchor user-task-ms-list-name
  msListName     String?
  /// @anchor user-task-ms-etag
  msEtag         String?
  /// @anchor user-task-ms-last-modified
  msLastModified DateTime?
  /// @anchor user-task-source
  source         String         @default("IGNITE")
  /// @anchor user-task-deleted-at
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// @anchor user-task-user
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// @anchor user-task-node
  node      ProcessNode?  @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  /// @anchor user-task-reminders
  reminders TaskReminder[]

  @@index([userId, deletedAt])
  @@index([userId, nodeId])
  @@index([msToDoId])
  @@map("user_tasks")
}

/// @anchor task-reminder
/// Alarm do zadania osobistego — per user, obsługuje snooze i Web Push.
model TaskReminder {
  /// @anchor task-reminder-id
  id          String    @id @default(uuid())
  /// @anchor task-reminder-user-task-id
  userTaskId  String
  /// @anchor task-reminder-user-id
  userId      String
  /// @anchor task-reminder-remind-at
  remindAt    DateTime
  /// @anchor task-reminder-sent-at
  sentAt      DateTime?
  /// @anchor task-reminder-snoozed-from
  snoozedFrom DateTime?
  /// @anchor task-reminder-recur-interval-minutes
  recurIntervalMinutes Int? // null = alarm jednorazowy; ustawione = interwał serii cyklicznej (min)
  /// @anchor task-reminder-recur-end
  recurEnd    DateTime? // koniec okna serii cyklicznej; po tej dacie alarm nie odpala
  /// @anchor task-reminder-last-fired-at
  lastFiredAt DateTime? // ostatnie wyświetlone wystąpienie serii — kursor „już pokazane"
  createdAt   DateTime  @default(now())

  /// @anchor task-reminder-user-task
  userTask UserTask @relation(fields: [userTaskId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@index([userId])
  @@map("task_reminders")
}

/// @anchor ms-todo-sync-state
/// Stan synchronizacji MS To Do per user — deltaLink do inkrementalnego pobierania zmian.
model MsTodoSyncState {
  /// @anchor ms-todo-sync-state-user-id
  userId              String    @id
  /// @anchor ms-todo-sync-state-delta-link
  deltaLink           String?
  /// @anchor ms-todo-sync-state-started-at
  msTodoSyncStartedAt DateTime?
  /// @anchor ms-todo-sync-state-last-sync-at
  lastSyncAt          DateTime?
  /// @anchor ms-todo-sync-state-last-sync-error
  lastSyncError       String?

  /// @anchor ms-todo-sync-state-user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ms_todo_sync_state")
}

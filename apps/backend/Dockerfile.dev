# Pinujemy wersję Alpine (nie floating node:18-alpine) — dzięki temu snapshot repo apk
# jest spójny i rotacja pakietów Alpine (np. bump chromium) nie wywali buildu w trakcie deployu.
FROM node:18-alpine3.20

WORKDIR /usr/src/app

# Chromium dla Puppeteera (eksport PDF mailem/pobranie). Nie pobieramy Chromium przez puppeteer
# (PUPPETEER_SKIP_DOWNLOAD) — używamy systemowego z apk. ENV przed npm install, by install nie ciągnął Chromium.
ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

COPY package*.json ./
COPY prisma ./prisma/

RUN apk add --no-cache openssl chromium nss freetype harfbuzz ca-certificates ttf-freefont
RUN npm install
RUN npx prisma generate

COPY . .

# Migracje, seed ról, build i start.
#
# `prisma migrate deploy` stosuje wyłącznie pliki z prisma/migrations — razem z danymi
# w nich zawartymi (INSERT/UPDATE) — i niczego nie kasuje na własną rękę.
# `db push` (poprzednia wersja) wyliczał zmiany z różnicy schematu: pomijał dane z migracji,
# a przy rozjeździe albo przerywał start, albo z --accept-data-loss usuwał kolumny i tabele.
#
# `seed.js` jest idempotentny (same `upsert` ról i uprawnień) — bezpieczny na każdym środowisku.
# Seed użytkowników NIE jest tu uruchamiany: nadpisywał hasła istniejących kont danymi
# z pliku w repo. Uruchamiaj go świadomie i ręcznie:
#   docker exec erp-backend node prisma/seed-users-from-json.js
CMD ["sh", "-c", "npx prisma generate && npx prisma migrate deploy && node prisma/seed.js && rm -f tsconfig.tsbuildinfo && npx tsc -p tsconfig.json && node dist/main"]
